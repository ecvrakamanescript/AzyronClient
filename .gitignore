.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/
**/azure.local.json
**/auth-cache*.json

# ------------------------------------------------------------
# Local files, not for the repository
# ------------------------------------------------------------
CLAUDE.md
claude.txt

# ------------------------------------------------------------
# Launcher (Node.js / Electron / TypeScript)
# ------------------------------------------------------------
node_modules/
dist/
out/
release/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# ------------------------------------------------------------
# Client (Java / Gradle / Fabric Loom / Stonecutter)
# ------------------------------------------------------------
.gradle/
build/
run/
runs/
.kotlin/
*.class
hs_err_pid*
replay_pid*
