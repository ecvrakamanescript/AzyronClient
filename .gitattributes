# Keep line endings consistent (Windows machine, platform-neutral repository)
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never modify binary files
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.woff2 binary
